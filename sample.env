CB_EMAIL=<your gmail id from where you will send emails>
CB_EMAIL_PWD=<your app password, not the email password>
MCP_TRANSPORT=stdio
# Required only when MCP_TRANSPORT=streamable-http. Keep this secret.
MCP_AUTH_TOKEN=
OPENAI_API_KEY=<your OpenAI API key>
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HR_RAG_MIN_RELEVANCE_SCORE=0.2
# Optional. Defaults to data/hr_assist.sqlite3 in the project directory.
HR_DATABASE_PATH=
